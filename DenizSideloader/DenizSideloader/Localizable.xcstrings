        "en" : { "stringUnit" : { "state" : "translated", "value" : "How renewal works" } }
      }
    },
    "refresh.how.body" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kostenlose Apple-IDs laufen nach 7 Tagen ab. Diese App erinnert dich rechtzeitig; das eigentliche Erneuern läuft per USB in DenizSigner auf Windows. Eine garantierte Hintergrund-Erneuerung gibt es auf iOS nicht." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Free Apple IDs expire after 7 days. This app reminds you in time; the actual renewal runs in DenizSigner on Windows via USB. iOS cannot guarantee background renewal." } }
      }
    },
    "refresh.last" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Letzte erfolgreiche Verlängerung: %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Last successful renewal: %@" } }
      }
    },
    "refresh.last.never" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch keine Verlängerung aufgezeichnet." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No renewal recorded yet." } }
      }
    },
